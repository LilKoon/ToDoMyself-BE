PROJECT_NAME=Smart Todo Hub API
VERSION=1.0.0
API_V1_STR=/api/v1
SECRET_KEY=change-this-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL=postgresql+asyncpg://todo_user:todo_password123@localhost:5432/todo_db

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Smart Todo App <onboarding@resend.dev>

# Gmail / Custom SMTP (Alternative for sending to all recipients without custom domain)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-clone-gmail@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=Smart Todo Hub <your-clone-gmail@gmail.com>

CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

